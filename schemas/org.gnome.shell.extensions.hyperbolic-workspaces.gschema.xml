<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <enum id="org.gnome.shell.extensions.hyperbolic-workspaces.Modifier">
    <value nick="super" value="0"/><value nick="shift" value="1"/><value nick="control" value="2"/><value nick="alt" value="3"/>
  </enum>
  <enum id="org.gnome.shell.extensions.hyperbolic-workspaces.DiskModel">
    <value nick="klein" value="0"/><value nick="fitted" value="1"/><value nick="poincare-shader" value="2"/>
  </enum>
  <schema id="org.gnome.shell.extensions.hyperbolic-workspaces" path="/org/gnome/shell/extensions/hyperbolic-workspaces/">
    <key name="move-modifier" enum="org.gnome.shell.extensions.hyperbolic-workspaces.Modifier">
      <default>'super'</default>
      <summary>Modifier that turns a drag into a workspace move</summary>
    </key>
    <key name="disk-model" enum="org.gnome.shell.extensions.hyperbolic-workspaces.DiskModel">
      <default>'klein'</default>
      <summary>How the disk is drawn (temporary until the open question is answered; the default is a placeholder, not a decision)</summary>
    </key>
    <key name="page-keys-activate" type="b">
      <default>false</default>
      <summary>PgUp/PgDn activate the workspace like GNOME, instead of only moving focus like the demo</summary>
    </key>
  </schema>
</schemalist>
